---
import type { Locale } from '../i18n';
import { getMessages } from '../i18n';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

interface Props {
	locale: Locale;
	title?: string;
	description?: string;
	canonicalPath?: string;
}

const { locale, title, description, canonicalPath } = Astro.props;
const messages = getMessages(locale);
const siteUrl = Astro.site ?? new URL('https://telleria-art.pages.dev');
const spanishHomeUrl = new URL('/', siteUrl).href;
const englishHomeUrl = new URL('/en/', siteUrl).href;
const canonicalUrl = canonicalPath ? new URL(canonicalPath, siteUrl).href : undefined;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title ?? messages.brandName}</title>
		{description && <meta name="description" content={description} />}
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{canonicalUrl && <link rel="alternate" hreflang="es" href={spanishHomeUrl} />}
		{canonicalUrl && <link rel="alternate" hreflang="en" href={englishHomeUrl} />}
	</head>
	<body class="m-0 min-h-screen bg-surface-container-lowest font-body-md text-on-surface">
		<div class="flex min-h-screen flex-col">
			<SiteHeader locale={locale} messages={messages} />
			<main class="flex-1">
				<slot />
			</main>
			<SiteFooter messages={messages} />
		</div>
	</body>
</html>
