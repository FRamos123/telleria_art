---
import type { Locale } from '../i18n';
import { getMessages } from '../i18n';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

interface Props {
	locale: Locale;
	title?: string;
	description?: string;
	canonicalPath?: string;
	alternatePaths?: Partial<Record<Locale, string>>;
	preloadHomeFonts?: boolean;
}

const { locale, title, description, canonicalPath, alternatePaths = {}, preloadHomeFonts = false } = Astro.props;
const messages = getMessages(locale);
const siteUrl = Astro.site ?? new URL('https://telleria-art.pages.dev');
const canonicalUrl = canonicalPath ? new URL(canonicalPath, siteUrl).href : undefined;
const languagePaths: Partial<Record<Locale, string>> = {
	...alternatePaths,
	...(canonicalPath ? { [locale]: canonicalPath } : {}),
};
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{preloadHomeFonts && (
			<>
				<link rel="preload" href="/fonts/bodoni-moda-400-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
				<link rel="preload" href="/fonts/newsreader-400-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
				<link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
			</>
		)}
		<title>{title ?? messages.brandName}</title>
		{description && <meta name="description" content={description} />}
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{canonicalUrl && Object.entries(languagePaths).map(([alternateLocale, path]) => (
			path && <link rel="alternate" hreflang={alternateLocale} href={new URL(path, siteUrl).href} />
		))}
	</head>
	<body class="m-0 min-h-screen bg-surface-container-lowest font-body-md text-on-surface">
		<div class="flex min-h-screen flex-col">
			<a
				class="sr-only focus:not-sr-only focus:block focus:bg-surface-container-lowest focus:px-space-md focus:py-space-sm focus:font-label-technical focus:text-label-technical focus:text-on-surface focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
				href="#main-content"
			>
				{messages.skipToContent}
			</a>
			<SiteHeader locale={locale} messages={messages} languagePaths={languagePaths} />
			<main id="main-content" class="flex-1">
				<slot />
			</main>
			<SiteFooter locale={locale} messages={messages} />
		</div>
	</body>
</html>
