---
import ExhibitionContent from '../../components/ExhibitionContent.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { deriveExhibitionMetaDescription } from '../../domain/catalog-presentation';
import { getMessages, type Locale } from '../../i18n';
import { createResponsiveImage } from '../../infrastructure/sanity/image-url';
import { loadCatalogContent } from '../../infrastructure/sanity/catalog-content';

const locale: Locale = 'es';

export async function getStaticPaths() {
	const locale = 'es' as const;
	const catalog = await loadCatalogContent();
	const imageOptions = {
		projectId: import.meta.env.SANITY_PROJECT_ID ?? '',
		dataset: import.meta.env.SANITY_DATASET ?? '',
	};

	return catalog.exhibitions.flatMap((exhibition) => {
		const translation = exhibition.translations[locale];
		if (!translation) return [];

		const visibleArtworks = catalog.artworks.flatMap((artwork) => {
			const artworkTranslation = artwork.translations[locale];
			return translation.artworkIds.includes(artwork.id) && artworkTranslation
				? [{
					id: artwork.id,
					title: artworkTranslation.title,
					href: `/obra/${encodeURIComponent(artwork.id)}/`,
				}]
				: [];
		});
		const visibleSeries = catalog.series.flatMap((series) => {
			const seriesTranslation = series.translations[locale];
			return translation.seriesIds.includes(series.id) && seriesTranslation
				? [{
					id: series.id,
					title: seriesTranslation.name,
					href: `/series/${encodeURIComponent(series.id)}/`,
				}]
				: [];
		});

		const imageProjection = catalog.exhibitionImageProjections.get(exhibition.id);
		let image: { assetId: string; responsive: ReturnType<typeof createResponsiveImage> } | undefined;
		if (translation.image && imageProjection?.asset._id === translation.image.assetId) {
			try {
				image = {
					assetId: translation.image.assetId,
					responsive: createResponsiveImage(imageProjection, imageOptions),
				};
			} catch {
				// An optional image that cannot be transformed must not block the exhibition page.
			}
		}

		return [{
			params: { exhibitionId: exhibition.id },
			props: { exhibition, visibleArtworks, visibleSeries, image },
		}];
	});
}

const { exhibition, visibleArtworks, visibleSeries, image } = Astro.props;
const messages = getMessages(locale);
const translation = exhibition.translations[locale];
const exhibitionPath = `/exposiciones/${encodeURIComponent(exhibition.id)}/`;
const alternatePaths: Partial<Record<Locale, string>> = {
	...(exhibition.translations.es ? { es: exhibitionPath } : {}),
	...(exhibition.translations.en
		? { en: `/en/exhibitions/${encodeURIComponent(exhibition.id)}/` }
		: {}),
};
const siteUrl = Astro.site ?? new URL('https://telleria-art.pages.dev');
const canonicalUrl = new URL(exhibitionPath, siteUrl).href;
const title = `${translation.title} — ${messages.exhibitionsTitle}`;
const dateFormatter = new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeZone: 'UTC' });
const formatDate = (date: string) => dateFormatter.format(new Date(`${date}T00:00:00Z`));
const description = deriveExhibitionMetaDescription({
	title: translation.title,
	venue: translation.venue,
	localizedStartDate: formatDate(exhibition.startDate),
	...(exhibition.endDate ? { localizedEndDate: formatDate(exhibition.endDate) } : {}),
});
const event = {
	'@context': 'https://schema.org',
	'@type': 'Event',
	'@id': canonicalUrl,
	url: canonicalUrl,
	name: translation.title,
	location: { '@type': 'Place', name: translation.venue },
	startDate: exhibition.startDate,
	...(exhibition.endDate ? { endDate: exhibition.endDate } : {}),
	inLanguage: locale,
	...(image ? { image: image.responsive.src } : {}),
	...(visibleArtworks.length > 0 ? {
		workFeatured: visibleArtworks.map((artwork) => ({
			'@type': 'VisualArtwork',
			name: artwork.title,
			url: new URL(artwork.href, siteUrl).href,
		})),
	} : {}),
	...(visibleSeries.length > 0 ? {
		about: visibleSeries.map((series) => ({
			'@type': 'CreativeWorkSeries',
			name: series.title,
			url: new URL(series.href, siteUrl).href,
		})),
	} : {}),
};
const eventJsonLd = JSON.stringify(event).replaceAll('<', '\\u003c');
---

<BaseLayout
	locale={locale}
	title={title}
	description={description}
	canonicalPath={exhibitionPath}
	alternatePaths={alternatePaths}
>
	<script type="application/ld+json" set:html={eventJsonLd} />
	<ExhibitionContent
		exhibition={exhibition}
		locale={locale}
		visibleArtworks={visibleArtworks}
		visibleSeries={visibleSeries}
		image={image}
	/>
</BaseLayout>
