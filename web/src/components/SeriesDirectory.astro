---
import { getMessages, type Locale } from '../i18n';

interface Props {
	locale: Locale;
	visibleSeries: readonly { id: string; name: string; href: string }[];
	activeSeriesId?: string;
	catalogHref?: string;
}

const { locale, visibleSeries, activeSeriesId, catalogHref } = Astro.props;
const messages = getMessages(locale);
const resolvedCatalogHref = catalogHref?.trim();
const validCatalogHref = resolvedCatalogHref
	&& resolvedCatalogHref.startsWith('/')
	&& !resolvedCatalogHref.startsWith('//')
	? resolvedCatalogHref
	: undefined;
const links = visibleSeries.flatMap((series) => {
	const id = series.id.trim();
	const name = series.name.trim();
	const href = series.href.trim();
	return id && name && href.startsWith('/') && !href.startsWith('//')
		? [{ id, name, href }]
		: [];
});
---

{links.length > 0 && (
	<section id="series-directory" aria-labelledby="series-directory-heading" class="mb-space-xl border-y border-outline-variant bg-surface-container p-space-md">
		<div class="flex flex-col gap-space-sm desktop:flex-row desktop:items-center desktop:justify-between">
			<h2 id="series-directory-heading" class="m-0 font-label-technical text-label-technical uppercase text-on-surface-variant">
				{messages.series}
			</h2>
			<ul class="m-0 flex list-none flex-wrap gap-space-sm p-0">
				{validCatalogHref && (
					<li>
						<a
							class:list={[
								'inline-flex items-center px-space-sm py-space-xs font-label-technical text-label-technical uppercase focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary',
								activeSeriesId
									? 'bg-surface-container-high text-on-surface hover:bg-surface-bright'
									: 'bg-on-surface text-surface-container-lowest',
							]}
							aria-current={activeSeriesId ? undefined : 'page'}
							href={validCatalogHref}
						>
							{messages.catalogAllSeriesLink} ({links.length})
						</a>
					</li>
				)}
				{links.map((series) => {
					const isActive = activeSeriesId === series.id;
					return (
						<li>
							<a
								class:list={[
									'inline-flex items-center px-space-sm py-space-xs font-label-technical text-label-technical uppercase focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary',
									isActive
										? 'bg-on-surface text-surface-container-lowest'
										: 'bg-surface-container-high text-on-surface underline decoration-surface-variant underline-offset-4 hover:bg-surface-bright hover:text-primary',
								]}
								aria-current={isActive ? 'page' : undefined}
								href={series.href}
							>
								{series.name}
							</a>
						</li>
					);
				})}
			</ul>
		</div>
	</section>
)}
