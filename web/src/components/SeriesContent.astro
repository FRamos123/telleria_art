---
import { isValidAlternativeText } from '../domain/completeness';
import type { Locale } from '../i18n';
import { getMessages } from '../i18n';
import type { MappedArtwork, MappedSeries } from '../infrastructure/sanity/mappers';
import type { ResponsiveImage } from '../infrastructure/sanity/image-url';
import ArtworkCard from './ArtworkCard.astro';
import EditorialImage from './EditorialImage.astro';
import HomeContactSection from './HomeContactSection.astro';
import SeriesDirectory from './SeriesDirectory.astro';

interface CatalogArtworkCard {
	artwork: MappedArtwork;
	image: ResponsiveImage;
	href: string;
}

interface Props {
	series: MappedSeries;
	locale: Locale;
	visibleArtworks: readonly CatalogArtworkCard[];
	allVisibleSeries?: readonly { id: string; name: string; href: string }[];
	image?: { assetId: string; responsive: ResponsiveImage };
	catalogHref: string;
	canonicalUrl: string;
	hasContactRoute?: boolean;
}

const {
	series,
	locale,
	visibleArtworks,
	allVisibleSeries = [],
	image,
	catalogHref,
	canonicalUrl,
	hasContactRoute = true,
} = Astro.props;
const translation = series.translations[locale];
const name = translation?.name.trim();
const description = translation?.description?.trim();
const artworks = visibleArtworks.flatMap((artwork) => {
	const title = artwork.artwork.translations[locale]?.title.trim();
	const href = artwork.href.trim();
	return artwork.artwork.id.trim() && title && href.startsWith('/') && !href.startsWith('//')
		? [{ ...artwork, href }]
		: [];
});
const messages = getMessages(locale);
const seriesImage = translation?.image;
const responsiveImage = image
	&& seriesImage
	&& image.assetId.trim()
	&& image.assetId === seriesImage.assetId
	&& image.responsive.src.trim()
	&& image.responsive.srcSet.trim()
	&& Number.isInteger(image.responsive.width)
	&& image.responsive.width > 0
	&& Number.isInteger(image.responsive.height)
	&& image.responsive.height > 0
	&& isValidAlternativeText(seriesImage.altText, name)
	? image.responsive
	: undefined;
const collectionPage = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	'@id': canonicalUrl,
	url: canonicalUrl,
	name,
	inLanguage: locale,
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: artworks.map(({ artwork, href }, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			item: {
				'@type': 'VisualArtwork',
				name: artwork.translations[locale]?.title,
				url: new URL(href, canonicalUrl).href,
			},
		})),
	},
};
const collectionPageJsonLd = JSON.stringify(collectionPage).replaceAll('<', '\\u003c');
---

{translation && name && artworks.length > 0 && (
	<>
		<script type="application/ld+json" set:html={collectionPageJsonLd} />
		<article class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-y-space-lg px-margin-mobile py-space-xl tablet:grid-cols-8 tablet:gap-x-gutter-mobile desktop:grid-cols-12 desktop:gap-x-gutter desktop:px-gutter">
			{allVisibleSeries.length > 0 && (
				<div class="tablet:col-span-8 desktop:col-span-12">
					<SeriesDirectory
						locale={locale}
						visibleSeries={allVisibleSeries}
						activeSeriesId={series.id}
						catalogHref={catalogHref}
					/>
				</div>
			)}

			{responsiveImage && seriesImage && (
				<figure class="relative m-0 flex items-center justify-center bg-surface-container-low tablet:col-span-8 desktop:col-span-7">
					<EditorialImage
						image={responsiveImage}
						altText={seriesImage.altText}
						className="h-auto w-full object-contain"
						loading="eager"
						sizes="(min-width: 1280px) 58vw, 100vw"
					/>
				</figure>
			)}

			<div class:list={[
				'flex min-w-0 flex-col gap-space-lg tablet:col-span-8',
				responsiveImage ? 'desktop:col-span-5' : 'desktop:col-span-12',
			]}>
				<header class="flex flex-col gap-space-sm">
					<p class="m-0 font-label-technical text-label-technical uppercase text-primary">
						{messages.series} · {artworks.length}
					</p>
					<h1 class="m-0 break-words font-headline-lg-mobile text-headline-lg-mobile uppercase text-on-surface desktop:font-headline-lg desktop:text-headline-lg">
						{name}
					</h1>
					{description && (
						<p class="m-0 whitespace-pre-line font-body-lg text-body-lg text-on-surface-variant">
							{description}
						</p>
					)}
					<a class="mt-space-sm inline-block w-fit font-label-technical text-label-technical uppercase text-on-surface underline decoration-surface-variant underline-offset-4 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary" href={catalogHref}>
						{messages.backToCatalog}
					</a>
				</header>
			</div>

			<section aria-labelledby={`series-${series.id}-works-title`} class="mt-space-lg border-t border-outline-variant pt-space-xl tablet:col-span-8 desktop:col-span-12">
				<h2 id={`series-${series.id}-works-title`} class="mb-space-lg mt-0 font-label-technical text-label-technical uppercase text-primary">
					{messages.seriesWorks}
				</h2>
				<ul class="m-0 grid list-none grid-cols-1 gap-x-gutter-mobile gap-y-space-xl p-0 tablet:grid-cols-8 desktop:grid-cols-12 desktop:gap-x-gutter">
					{artworks.map((artwork) => (
						<ArtworkCard
							artwork={artwork.artwork}
							image={artwork.image}
							href={artwork.href}
							locale={locale}
							seriesName={name}
						/>
					))}
				</ul>
			</section>
		</article>
		<HomeContactSection locale={locale} hasContactRoute={hasContactRoute} />
	</>
)}
