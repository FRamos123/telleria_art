---
import type { Locale } from '../i18n';
import { getMessages } from '../i18n';
import type { MappedArtwork } from '../infrastructure/sanity/mappers';
import type { ResponsiveImage } from '../infrastructure/sanity/image-url';
import HomeArtworkFeature from './HomeArtworkFeature.astro';

interface HomeArtworkCard {
	artwork: MappedArtwork;
	image: ResponsiveImage;
	href: string;
	series: { name: string; href: string };
	contactHref?: string;
}

interface Props {
	locale: Locale;
	cards: readonly HomeArtworkCard[];
}

const { locale, cards } = Astro.props;
const messages = getMessages(locale);
---

{cards.length > 0 && (
	<section
		id="catalogo"
		aria-labelledby="home-artwork-selection-heading"
		class="mx-auto w-full max-w-7xl px-margin-mobile py-space-xl desktop:px-gutter"
	>
		<h2
			id="home-artwork-selection-heading"
			class="sr-only"
		>
			{messages.homeArtworkSelectionTitle}
		</h2>
		<div class="flex flex-col gap-y-space-xl">
			{cards.map((card, index) => (
				<div class={index > 0 ? 'border-t border-outline-variant pt-space-xl' : undefined}>
					<HomeArtworkFeature
						{...card}
						locale={locale}
						reversed={index % 2 === 1}
						loading={index === 0 ? 'eager' : 'lazy'}
					/>
				</div>
			))}
		</div>
	</section>
)}
