---
import { isValidAlternativeText } from '../domain/completeness';
import type { Locale } from '../i18n';
import { getMessages } from '../i18n';
import type { MappedExhibition } from '../infrastructure/sanity/mappers';
import type { ResponsiveImage } from '../infrastructure/sanity/image-url';
import EditorialImage from './EditorialImage.astro';

interface RelatedDestination {
	id: string;
	title: string;
	href: string;
}

interface Props {
	exhibition: MappedExhibition;
	locale: Locale;
	visibleArtworks?: readonly RelatedDestination[];
	visibleSeries?: readonly RelatedDestination[];
	image?: { assetId: string; responsive: ResponsiveImage };
}

const {
	exhibition,
	locale,
	visibleArtworks = [],
	visibleSeries = [],
	image,
} = Astro.props;
const translation = exhibition.translations[locale];
const title = translation?.title.trim();
const venue = translation?.venue.trim();
const messages = getMessages(locale);
const localizedDate = new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeZone: 'UTC' });
const formatDate = (date: string) => localizedDate.format(new Date(`${date}T00:00:00Z`));
const artworkIds = new Set(translation?.artworkIds ?? []);
const seriesIds = new Set(translation?.seriesIds ?? []);
const relatedArtworks = visibleArtworks.flatMap((artwork) => {
	const id = artwork.id.trim();
	const text = artwork.title.trim();
	const href = artwork.href.trim();
	return id && artworkIds.has(id) && text && href.startsWith('/') && !href.startsWith('//')
		? [{ ...artwork, id, title: text, href }]
		: [];
});
const relatedSeries = visibleSeries.flatMap((series) => {
	const id = series.id.trim();
	const text = series.title.trim();
	const href = series.href.trim();
	return id && seriesIds.has(id) && text && href.startsWith('/') && !href.startsWith('//')
		? [{ ...series, id, title: text, href }]
		: [];
});
const exhibitionImage = translation?.image;
const responsiveImage = image
	&& exhibitionImage
	&& image.assetId.trim()
	&& image.assetId === exhibitionImage.assetId
	&& image.responsive.src.trim()
	&& image.responsive.srcSet.trim()
	&& Number.isInteger(image.responsive.width)
	&& image.responsive.width > 0
	&& Number.isInteger(image.responsive.height)
	&& image.responsive.height > 0
	&& isValidAlternativeText(exhibitionImage.altText, title)
	? image.responsive
	: undefined;
---

{translation && title && venue && (
	<article class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-y-space-lg px-margin-mobile py-space-lg tablet:grid-cols-8 tablet:gap-x-gutter-mobile desktop:grid-cols-12 desktop:gap-x-gutter desktop:px-gutter">
		{responsiveImage && exhibitionImage && (
			<figure class="relative m-0 flex items-center justify-center bg-surface-container-low tablet:col-span-8 desktop:col-span-7">
				<EditorialImage
					image={responsiveImage}
					altText={exhibitionImage.altText}
					className="h-auto w-full object-contain"
					loading="eager"
					sizes="(min-width: 1280px) 58vw, 100vw"
				/>
			</figure>
		)}

		<div class:list={[
			'flex min-w-0 flex-col gap-space-lg tablet:col-span-8',
			responsiveImage ? 'desktop:col-span-5' : 'desktop:col-span-12',
		]}>
			<header>
				<h1 class="mb-space-sm mt-0 break-words font-headline-lg-mobile text-headline-lg-mobile text-on-surface desktop:font-headline-lg desktop:text-headline-lg">
					{title}
				</h1>
				<dl class="m-0">
					<div class="flex flex-col gap-space-xs border-b border-surface-variant py-space-sm tablet:flex-row tablet:items-start tablet:justify-between">
						<dt class="font-label-caption text-label-caption text-on-surface-variant">{messages.exhibitionVenue}</dt>
						<dd class="m-0 font-body-md text-body-md text-on-surface tablet:text-right">{venue}</dd>
					</div>
					<div class="flex flex-col gap-space-xs py-space-sm tablet:flex-row tablet:items-start tablet:justify-between">
						<dt class="font-label-caption text-label-caption text-on-surface-variant">{messages.exhibitionDates}</dt>
						<dd class="m-0 font-body-md text-body-md text-on-surface tablet:text-right">
							<time datetime={exhibition.startDate}>{formatDate(exhibition.startDate)}</time>
							{exhibition.endDate && (
								<> – <time datetime={exhibition.endDate}>{formatDate(exhibition.endDate)}</time></>
							)}
						</dd>
					</div>
				</dl>
			</header>

			{relatedArtworks.length > 0 && (
				<section aria-labelledby={`exhibition-${exhibition.id}-artworks-title`}>
					<h2 id={`exhibition-${exhibition.id}-artworks-title`} class="mb-space-sm mt-0 font-label-technical text-label-technical text-on-surface">
						{messages.exhibitionArtworks}
					</h2>
					<ul class="m-0 grid list-none grid-cols-1 gap-x-space-lg p-0 tablet:grid-cols-2">
						{relatedArtworks.map((artwork) => (
							<li class="border-b border-surface-variant py-space-sm">
								<a class="font-body-md text-body-md text-on-surface underline decoration-surface-variant" href={artwork.href}>
									{artwork.title}
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			{relatedSeries.length > 0 && (
				<section aria-labelledby={`exhibition-${exhibition.id}-series-title`}>
					<h2 id={`exhibition-${exhibition.id}-series-title`} class="mb-space-sm mt-0 font-label-technical text-label-technical text-on-surface">
						{messages.exhibitionSeries}
					</h2>
					<ul class="m-0 grid list-none grid-cols-1 gap-x-space-lg p-0 tablet:grid-cols-2">
						{relatedSeries.map((series) => (
							<li class="border-b border-surface-variant py-space-sm">
								<a class="font-body-md text-body-md text-on-surface underline decoration-surface-variant" href={series.href}>
									{series.title}
								</a>
							</li>
						))}
					</ul>
				</section>
			)}
		</div>
	</article>
)}
