---
import type { Locale, Messages } from '../i18n';

interface Props {
	locale: Locale;
	messages: Messages;
	languagePaths: Partial<Record<Locale, string>>;
}

const { locale, messages, languagePaths } = Astro.props;
const spanishPath = languagePaths.es;
const englishPath = languagePaths.en;
---

<div
	class="inline-flex items-center gap-space-xs border border-outline-variant bg-surface-container-low p-space-xs font-label-technical text-label-technical uppercase"
	role="group"
	aria-label={messages.languageSelectorLabel}
>
	{spanishPath ? (
		<a
			class:list={[
				'inline-flex min-h-8 items-center justify-center px-space-xs py-space-xs no-underline focus-visible:outline-2 focus-visible:outline-primary tablet:px-space-sm',
				locale === 'es'
					? 'bg-primary text-on-primary'
					: 'text-on-surface hover:bg-surface-container-high hover:text-primary',
			]}
			href={spanishPath}
			lang="es"
			aria-label={`ES, ${messages.spanishLanguage}`}
			aria-current={locale === 'es' ? 'page' : undefined}
		>
			ES
		</a>
	) : (
		<span class="inline-flex min-h-8 items-center justify-center px-space-xs py-space-xs text-on-surface-variant tablet:px-space-sm" lang="es">
			ES
		</span>
	)}
	<span aria-hidden="true" class="text-on-surface-variant">/</span>
	{englishPath ? (
		<a
			class:list={[
				'inline-flex min-h-8 items-center justify-center px-space-xs py-space-xs no-underline focus-visible:outline-2 focus-visible:outline-primary tablet:px-space-sm',
				locale === 'en'
					? 'bg-primary text-on-primary'
					: 'text-on-surface hover:bg-surface-container-high hover:text-primary',
			]}
			href={englishPath}
			lang="en"
			aria-label={`EN, ${messages.englishLanguage}`}
			aria-current={locale === 'en' ? 'page' : undefined}
		>
			EN
		</a>
	) : (
		<span class="inline-flex min-h-8 items-center justify-center px-space-xs py-space-xs text-on-surface-variant tablet:px-space-sm" lang="en">
			EN
		</span>
	)}
</div>
